# 数据文件（太大，不推）
data/em_data_meep/
data/em_data/
data/data/
data/blank/
*.npy
*.npz

# 模型权重（含子目录）
checkpoints/*.pth
checkpoints/**/*.pth
# checkpoints/ 目录被 git 视为未跟踪目录，加这条让 .pth 规则真正生效
checkpoints/
# 训练产物（归一化统计量、summary），与权重同源，不入库
checkpoints/**/*.json
checkpoints/**/*.npz

# HFSS 场文件（单文件几十 MB）
*.fld

# 本地 Python 环境
**/.venv/
venv/

# 本地工具目录（个人配置，不进版本库）
.kiro/
.vscode/

# 传播工具输出
field2field/out_result/

# Python 缓存
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# 临时文件
*.tar.gz
cloudflared
vscode_cli*
*.log
.tmp/
.scholar_tmp/

# 可编辑安装产物
*.egg-info/
build/
dist/

# 对比实验输出
runs/

# 系统文件
.DS_Store
Thumbs.db

propagation/